# Copy this file to .env.local and fill in the values from your Supabase
# project's Settings -> API page.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only used by server-side code (never exposed to the browser). Also on
# Settings -> API, under "service_role" — keep this one secret.
SUPABASE_SERVICE_ROLE_KEY=
